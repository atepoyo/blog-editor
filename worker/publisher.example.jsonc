{
  "name": "blog-editor-publisher",
  "main": "publisher.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "EDITOR_ORIGIN": "https://editor.example.com",
    "ACCESS_ISSUER": "https://your-team.cloudflareaccess.com",
    "ACCESS_AUD": "YOUR_ACCESS_APPLICATION_AUD",
    "ALLOWED_EMAILS": "you@example.com",
    "GITHUB_APP_ID": "YOUR_APP_ID",
    "GITHUB_OWNER": "YOUR_PERSONAL_ACCOUNT",
    "GITHUB_REPOSITORY": "YOUR_REPOSITORY",
    "GITHUB_BRANCH": "YOUR_BRANCH"
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "your-images-bucket" }]
}
