{
  "name": "blog-editor-gateway",
  "main": "gateway.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    { "binding": "PUBLISHER", "service": "blog-editor-publisher" },
    { "binding": "POSTING_UI", "service": "blog-editor-posting-ui" }
  ],
  "vars": {
    "EDITOR_ORIGIN": "https://publish.example.com",
    "COMMON_EDITOR_ORIGIN": "https://editor.example.com",
    "ACCESS_ISSUER": "https://your-team.cloudflareaccess.com",
    "ACCESS_AUD": "YOUR_ACCESS_APPLICATION_AUD",
    "ALLOWED_EMAILS": "you@example.com"
  }
}
